{
  "compilerOptions": {
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "module": "preserve",
    "declaration": true,
    "composite": true,
    "declarationMap": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "lib": ["ES2023", "dom"],
    "jsx": "react-jsx"
  },
  "include": ["./src/**/*"],
  "exclude": ["./src/**/*.test.ts"],
  "references": [{ "path": "../fiveway" }]
}
